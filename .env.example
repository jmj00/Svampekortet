# Copy this file to `.env` (git-ignored) and fill in real values.
# NEVER commit `.env`. NEVER paste these values into chat, issues or commits.

# --- Datafordeler (https://datafordeler.dk) OAuth Shared Secret ---
# From an IT-system's "OAuth Shared Secret" tab in Datafordeler Administration
# (portal.datafordeler.dk/hjem). The secret is shown only once at creation --
# copy it there directly into this file, never into chat. Used for
# datafordeler.dk services that a plain API key can't reach (e.g. GeoDanmark
# Vektor forest polygons, Danske Stednavne place names): exchange these for a
# 60-minute bearer token at
# https://auth.datafordeler.dk/realms/distribution/protocol/openid-connect/token
# (grant_type=client_credentials), then call the service with
# `Authorization: Bearer <token>`.
DATAFORDELER_CLIENT_ID=
DATAFORDELER_CLIENT_SECRET=

# --- DMI Open Data ---
# No key required since 2025-12-02. Use host opendataapi.dmi.dk (NOT dmigw.govcloud.dk).
# Nothing to configure.

# --- GBIF (https://gbif.org) ---
# Only needed for the citable bulk *download* API, not for the spikes.
GBIF_USER=
GBIF_PWD=
GBIF_EMAIL=
